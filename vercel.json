{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "functions": {
    "api/idgaf.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/idgaf/process", "destination": "/api/idgaf" },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
